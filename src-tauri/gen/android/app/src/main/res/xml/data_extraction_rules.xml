<?xml version="1.0" encoding="utf-8"?>
<!--
  Kaze keeps nothing in Android backups or device transfers. Its sign-in token is
  encrypted with a key that never leaves this phone, so restored data would carry
  a session that can't be read and never syncs. The account's data lives in the
  cloud; a new install signs in and pulls it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
