{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaze",
  "version": "1.0.1",
  "identifier": "org.intelligentmusicplayer.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaze",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "A calm, intelligent local music player",
    "longDescription": "Kaze is a beautiful, fast, and intelligent local music player. Browse your library, build playlists, discover music, and enjoy a calm, distraction-free listening experience — all from your desktop.",
    "copyright": "© 2024 Kaze Contributors",
    "linux": {
      "deb": {
        "depends": ["libasound2", "libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["alsa-lib", "webkit2gtk4.1", "gtk3"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English"],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": null
    },
    "createUpdaterArtifacts": true,
    "publisher": "Kaze Contributors"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNjc5NEE4NTdBQzhBRTQKUldUa2lxeFhxSlJueTl4L0hvTlJrWjFCMGdDTm1ITU5ldHZLVVNmTnlqTVB1T1k1eVdTVHlBeXEK",
      "endpoints": [
        "https://github.com/selfAnnihilator/kaze/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
